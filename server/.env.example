# ── Core ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Comma-separated browser origins; email links use CLIENT_URL or the first origin.
CLIENT_URLS=http://localhost:5173
# Number of trusted reverse-proxy hops (Render: 1; local: 0).
TRUST_PROXY=0

# ── MongoDB ────────────────────────────────────────────
# Local (via `docker compose up`):
MONGODB_URI=mongodb://localhost:27017/heyfuturejasmine
# Atlas alternative:
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/heyfuturejasmine

# ── JWT (CHANGE THESE) ─────────────────────────────────
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── Redis (BullMQ delivery queue) ──────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Cloudinary (optional) ──────────────────────────────
# Without these, uploads are disabled (the app still runs).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email / Resend (optional) ──────────────────────────
# Without RESEND_API_KEY, emails are logged to the console instead of sent.
RESEND_API_KEY=
EMAIL_FROM=HeyFutureJasmine <no-reply@heyfuturejasmine.app>

# ── Dev helpers ────────────────────────────────────────
# Enables the dev-only "force deliver" endpoint for testing the reveal.
ENABLE_DEV_ROUTES=true
